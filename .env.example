# ===========================================
# AirSafe India - Environment Variables
# ===========================================
# Copy this file to .env.local for local development
# DO NOT commit .env.local to git!
# ===========================================

# Google Gemini API Key (Required for AI Copilot)
# Get yours at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeather API Key (Optional - has Open-Meteo fallback)
# Get yours at: https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Gemini Model (Optional - defaults to gemini-2.5-flash)
VITE_GEMINI_MODEL=gemini-2.5-flash
